rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user can read/write their own doc.
    // Pairing: any signed-in user can look up a doc by pairCode and set the
    // partnerUid field on it (and only that field).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerUid'])
      );
    }

    // Alerts:
    // - only the sender can create one, and only addressed to their own partner
    // - only the addressee can read it (the app listens to its own alerts)
    // - nobody can edit or delete from the client
    match /alerts/{alertId} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerUid
           == request.resource.data.toUid;
      allow read: if request.auth != null
        && resource.data.toUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
